{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/app/**",
              "components/brand/**",
              "components/core/**",
              "components/marketing/**",
              "ui_kits/cardfit-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Inter, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|enabled|key|ref|className|style|children)$/]",
        "message": "<AppSwitch> doesn't accept that prop. Declared props: label, checked, onChange, enabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|help|type|style|key|ref|className|style|children)$/]",
        "message": "<AppTextField> doesn't accept that prop. Declared props: label, value, onChange, placeholder, help, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArcDivider'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<ArcDivider> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArcField'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|cx|cy|className|style|key|ref|className|style|children)$/]",
        "message": "<ArcField> doesn't accept that prop. Declared props: tone, cx, cy, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArcField'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ArcField> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|block|href|children|className|onClick|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, block, href, children, className, onClick, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|teal|sage|light)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'teal' | 'sage' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardArtwork'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|style|className|key|ref|className|style|children)$/]",
        "message": "<CardArtwork> doesn't accept that prop. Declared props: type, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardArtwork'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:pan|aadhaar|epic|admit|custom|free)$/]",
        "message": "<CardArtwork> type must be one of 'pan' | 'aadhaar' | 'epic' | 'admit' | 'custom' | 'free'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseStudyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|status|title|body|tags|visual|className|key|ref|className|style|children)$/]",
        "message": "<CaseStudyCard> doesn't accept that prop. Declared props: href, label, status, title, body, tags, visual, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Container'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|style|key|ref|className|style|children)$/]",
        "message": "<Container> doesn't accept that prop. Declared props: children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|className|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|sage|light)$/]",
        "message": "<Eyebrow> tone must be one of 'teal' | 'sage' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HomeTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|icon|iconBg|iconColor|onClick|key|ref|className|style|children)$/]",
        "message": "<HomeTile> doesn't accept that prop. Declared props: title, subtitle, icon, iconBg, iconColor, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IllustratedTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|subtitle|artwork|selected|enabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IllustratedTile> doesn't accept that prop. Declared props: label, subtitle, artwork, selected, enabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:light|className|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: light, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutputChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<OutputChip> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenScaffold'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|bottomBar|height|children|className|key|ref|className|style|children)$/]",
        "message": "<ScreenScaffold> doesn't accept that prop. Declared props: title, onBack, bottomBar, height, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectableCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|enabled|onClick|key|ref|className|style|children)$/]",
        "message": "<SelectableCard> doesn't accept that prop. Declared props: label, selected, enabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|className|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: title, body, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValueBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|tone|className|key|ref|className|style|children)$/]",
        "message": "<ValueBlock> doesn't accept that prop. Declared props: title, body, tone, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValueBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|sage)$/]",
        "message": "<ValueBlock> tone must be one of 'teal' | 'sage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceArcsMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|light|className|key|ref|className|style|children)$/]",
        "message": "<VoiceArcsMark> doesn't accept that prop. Declared props: size, light, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
